{
  "expo": {
    "name": "ImposterAI",
    "slug": "imposter-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground-IAI.png",
        "backgroundImage": "./assets/android-icon-background-IAI.png",
        "monochromeImage": "./assets/android-icon-monochrome-IAI.png"
      },
      "package": "com.jdeng.impostergame"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8ab45bbf-2e89-4ac1-a6c7-8d95d9686cbd"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
